#
# SCENARIO 1 -- single g5.8xlarge, ~1B parameters, maximum memory occupancy.
#
# This is the MEASURED maximum for a 1B model on one A10G. Source of truth for
# both reproduction paths: `source` it for the direct-EC2 path, and the same
# values appear in kustomization.yaml for the Kubernetes path. Keep the two in
# step -- scenario-check.sh asserts they match.
#
# MEASURED 2026-10-03 (g5/results/run-20261003-101233.log):
#   parameters        1,009,385,472
#   peak allocated    19.08 GiB   = 84.8% of the A10G's 22.49 GiB
#   peak reserved     19.43 GiB
#   throughput        7,085 tok/s median
#   MODEL_TFLOP/s     34.3        (MFU 27.4%)
#   stability         0 skipped, 0 NaN over 50 steps on real c4
#
# WHY SEQ_LENGTH=1024 AND NOT 2048 -- this is the ceiling, measured not guessed.
# The identical geometry at SEQ_LENGTH=2048 was RUN and it OOMed
# (g5/results/run-20261003-104814.log): it completed ONE iteration, reached
# 20.05 GiB allocated with 38.25 MiB free, and died trying to allocate 36 MiB.
# So 84.8% is the real ceiling for this shape on this card, and raising
# SEQ_LENGTH is not a free way to use the remaining 3.41 GiB.
#
# The 3.41 GiB that is left is headroom, not waste: the allocator needs room to
# manoeuvre, and the measured fragmentation overhead (reserved/allocated) is
# 1.018 here.
NUM_LAYERS=20
HIDDEN_SIZE=1536
FFN_HIDDEN_SIZE=4608
NUM_ATTENTION_HEADS=12
NUM_QUERY_GROUPS=3
SEQ_LENGTH=1024
MICRO_BATCH_SIZE=1
GLOBAL_BATCH_SIZE=8
TRAIN_ITERS=50
LOG_INTERVAL=10
NNODES=1

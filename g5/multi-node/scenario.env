#
# SCENARIO 2 -- two g5.8xlarge over EFA, DP=2, maximum memory occupancy.
#
# Source of truth for both reproduction paths: `source` it for the direct-EC2
# path, and the same values appear in kustomization.yaml for the Kubernetes
# path. g5/scenario-check.sh asserts the two agree.
#
# ----------------------------------------------------------------- MEASURED
# 2026-10-05, 1000 iterations on real c4 over EFA, this exact geometry
# (g5/results/run-2node-20261005-101859-rank*.log):
#
#   parameters      1,490,550,784
#   peak allocated  19.27 GiB   = 85.7% of the A10G's 22.49 GiB
#   peak reserved   19.92 GiB   (fragmentation overhead 1.034)
#   throughput      5,753 tok/s median, stdev 26 (0.45%) over 99 steps
#   step time       2.848 s at 16,384 tok/step
#   transport       "Selected provider is efa" on both ranks
#   stability       loss 11.3351 -> 5.4236, 0 skipped, 0 NaN
#
# WHY THIS SHAPE and not a larger one. 2048/18 = 113.8 and Qwen3-8B is
# 4096/36 = 113.8 -- identical to three significant figures, so this is the
# best-proportioned proxy for the real architecture at this memory budget.
# Shapes holding MORE parameters exist (6 layers x 3072 reaches 1.58 B) and are
# 4.5x off that ratio. See g5/multi-node/max-model.py for the full search.
#
# THE SECOND NODE BUYS CAPACITY, NOT SPEED. This same card tops out at 1.01 B
# parameters on ONE node (19.08 GiB at 20 layers x 1536); DP=2 reaches 1.49 B,
# about +48%, because use_distributed_optimizer shards optimizer state. The
# step time is the gradient transfer either way -- 4,299 MB per step at
# 1,510 MB/s = 2.848 s, which is the measured step to 0.4%. See g5/README.md.
#
# ------------------------------------------------------- WHY SEQ_LENGTH=1024
# Not a cautious default: 2048 at the 20x1536 shape OOMed on ONE node
# (g5/results/run-20261003-104814.log -- one iteration, 20.05 GiB allocated,
# 38 MiB free). At DP=2 the sharding leaves room for it, which is now a
# prediction worth testing rather than an assumption; see the README.
NUM_LAYERS=18
HIDDEN_SIZE=2048
FFN_HIDDEN_SIZE=6144
NUM_ATTENTION_HEADS=16
NUM_QUERY_GROUPS=4
SEQ_LENGTH=1024
MICRO_BATCH_SIZE=1
# 16 = 8 sequences per rank at DP=2. tokens/step is GBS x seq REGARDLESS of
# node count, so leaving this at 8 would halve per-rank compute without
# shrinking the all-reduce.
GLOBAL_BATCH_SIZE=16
TRAIN_ITERS=1000
LOG_INTERVAL=10
NNODES=2
# NOT read by finish-run-2node.sh or run.sh. On the EC2 path USE_EFA is a
# PROVISIONING knob, consumed by g5/launch-instance.sh (which attaches the
# interface and sets the security-group shape) and g5/fix-cluster-sg.sh. The run
# itself AUTODETECTS the fabric from /dev/infiniband, because the device is
# either present or it is not and a flag could only disagree with the hardware.
# So source this file BEFORE launching, not just before running -- the README's
# recipe does. On Kubernetes it IS read at run time, by the pod script.
#
# Not optional at 2 nodes. Without an EFA device the 4-layer shape measured
# 8,086 tok/s against 24,727 on ONE node -- a 3x LOSS -- because the step
# degenerates to the gradient transfer at 4 Gbit/s. See g5/README.md.
USE_EFA=1
